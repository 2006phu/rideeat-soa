# ==============================================================================
# RideEat SOA Platform - Environment Configuration (.env.example)
# ==============================================================================

# --- PostgreSQL Configuration ---
POSTGRES_USER=rideeat
POSTGRES_PASSWORD=rideeat_secret_pwd
POSTGRES_DB=rideeat_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rideeat:rideeat_secret_pwd@postgres:5432/rideeat_db

# --- Redis Configuration (Cache, Geo-Index & Cart Store) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Apache Kafka Configuration (Event-Driven Architecture) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RIDE_EVENTS=ride.events
KAFKA_TOPIC_FOOD_EVENTS=food.events
KAFKA_TOPIC_PAYMENT_EVENTS=payment.events
KAFKA_TOPIC_NOTIFICATION_EVENTS=notification.events

# --- JWT & Security Configuration ---
JWT_SECRET_KEY=rideeat-super-secret-jwt-key-2026-soa-enterprise
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Internal Microservice URLs ---
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
RIDE_SERVICE_URL=http://ride-service:8003
FOOD_SERVICE_URL=http://food-service:8004
MAP_SERVICE_URL=http://map-service:8005
PAYMENT_SERVICE_URL=http://payment-service:8006
RATING_SERVICE_URL=http://rating-service:8007
PROMO_SERVICE_URL=http://promo-service:8008
NOTIFICATION_SERVICE_URL=http://notification-service:8009

# --- Frontend & API Gateway ---
API_GATEWAY_PORT=8080
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=rideeat_admin

# --- Firebase & External Integrations ---
FIREBASE_CREDENTIALS_PATH=./config/firebase/serviceAccountKey.json
GEMINI_API_KEY=

# --- Ngrok Public Tunnel (https://dashboard.ngrok.com/get-started/your-authtoken) ---
NGROK_AUTHTOKEN=
