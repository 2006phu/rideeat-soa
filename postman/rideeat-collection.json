  "item": [
    {
      "name": "1. Auth Service (:8001)",
      "item": [
        {
          "name": "Register Account (Customer / Driver / Merchant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('Response has standard SOA envelope or token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nguyenvana@rideeat.vn\",\n  \"phone\": \"0901234567\",\n  \"password\": \"RideEat@2026\",\n  \"full_name\": \"Nguyen Van A\",\n  \"role\": \"CUSTOMER\"\n}"
            }
          }
        },
        {
          "name": "Login (PasswordAuthStrategy -> JWT Issue)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Saves JWT access_token to collection variable', function () {",
                  "    var json = pm.response.json();",
                  "    var token = (json.data && json.data.access_token) || json.access_token;",
                  "    if (token) pm.collectionVariables.set('accessToken', token);",
                  "    pm.expect(token).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"nguyenvana@rideeat.vn\",\n  \"secret\": \"RideEat@2026\",\n  \"auth_type\": \"password\"\n}"
            }
          }
        },
        {
          "name": "Verify Token & RBAC Permissions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token verification returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/verify"
          }
        }
